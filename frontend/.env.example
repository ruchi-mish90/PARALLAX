# PARALLAX Chandrayaan-2 Registration Platform - Environment Configuration

# Backend API URL (default development port for FastAPI / Python CV server)
VITE_BACKEND_URL=http://127.0.0.1:8000

# API Base Path (forwarded by Vite dev proxy to VITE_BACKEND_URL)
VITE_API_BASE_URL=/api

# Toggle Live API vs Static Calibrated Benchmark Mode
# Set to "true" to query live backend; if backend is unreachable, gracefully falls back to benchmark data
VITE_ENABLE_LIVE_API=true

# Request Timeout in Milliseconds (default 45000ms for deep neural feature extraction)
VITE_API_TIMEOUT_MS=45000
